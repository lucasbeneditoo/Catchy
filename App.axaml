<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Catchy.App"
             xmlns:local="using:Catchy"
             RequestedThemeVariant="Default">

    <!-- "Default" follows the system theme -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <!-- Tema claro -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BackgroundColor" Color="#F7F7F7"/>
                    <SolidColorBrush x:Key="BottomBarColor" Color="#E5E5E5"/>
                    <SolidColorBrush x:Key="CardColor" Color="#FFFFFF"/>

                    <SolidColorBrush x:Key="PrimaryTextColor" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="SecondaryTextColor" Color="#666666"/>
                    <SolidColorBrush x:Key="IconColor" Color="#333333"/>

                    <SolidColorBrush x:Key="HoverColor" Color="#D8D8D8"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#D0D0D0"/>
                </ResourceDictionary>

                <!-- Tema escuro -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BackgroundColor" Color="#121212"/>
                    <SolidColorBrush x:Key="BottomBarColor" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="CardColor" Color="#242424"/>

                    <SolidColorBrush x:Key="PrimaryTextColor" Color="#F2F2F2"/>
                    <SolidColorBrush x:Key="SecondaryTextColor" Color="#A8A8A8"/>
                    <SolidColorBrush x:Key="IconColor" Color="#E0E0E0"/>

                    <SolidColorBrush x:Key="HoverColor" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#303030"/>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

</Application>